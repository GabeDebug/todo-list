<% content_for :title, "Todos" %>

<% if notice.present? %>
  <div
    class="
      mb-6 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl
      px-4 py-3
    "
  >
    <%= notice %>
  </div>
<% end %>

<div class="flex items-center justify-between mb-8">
  <h1 class="text-3xl font-extrabold text-slate-800 tracking-tight">Minhas Tarefas</h1>
  <%= link_to "＋ Nova tarefa",
  new_todo_path,
  class:
    "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold
                px-5 py-2.5 rounded-xl transition" %>
</div>

<div id="todos" class="space-y-4">
  <% if @todos.empty? %>
    <div class="text-center py-16 text-slate-400">
      <p class="text-5xl mb-4">📋</p>
      <p class="text-lg font-medium">Nenhuma tarefa ainda.</p>
      <p class="text-sm mt-1">Crie sua primeira tarefa acima!</p>
    </div>
  <% else %>
    <% @todos.each do |todo| %>
      <div class="flex items-center justify-between gap-4">
        <div class="flex-1">
          <%= render todo %>
        </div>
        <%= link_to "Ver",
        todo,
        class:
          "text-sm text-indigo-600 hover:text-indigo-800 font-medium whitespace-nowrap transition" %>
      </div>
    <% end %>
  <% end %>
</div>

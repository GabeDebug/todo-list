<% content_for :title, "Nova tarefa" %>

<div class="max-w-lg mx-auto">
  <div class="mb-6 flex items-center gap-3">
    <%= link_to todos_path, class: "text-slate-400 hover:text-slate-600 transition" do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"
        />
      </svg>
    <% end %>
    <h1 class="text-2xl font-extrabold text-slate-800 tracking-tight">Nova tarefa</h1>
  </div>

  <div class="bg-white border border-slate-100 rounded-2xl shadow-sm p-6">
    <%= render "form", todo: @todo %>
  </div>
</div>
